import { useState, useRef, useEffect, useCallback, useMemo } from 'react';
import { useLiveQuery } from 'dexie-react-hooks';
import { SendHorizonal, Database, Zap, Loader2, Settings, AlertTriangle, CheckCircle2, Bookmark } from 'lucide-react';
import ReactMarkdown from 'react-markdown';
import remarkGfm from 'remark-gfm';
import { getMessagesByChat, addMessage, updateMessageContent } from '../../db/messageHelpers.js';
import { compileContext } from '../../ai/contextCompiler.js';
import { streamChat } from '../../ai/llmService.js';
import { previewSnapshot, commitPreviewedItems, commitSnapshot } from '../../ai/snapshotEngine.js';
import SnapshotDiffModal from './SnapshotDiffModal.jsx';
import { addMemoryItem, suggestTags } from '../../db/memoryHelpers.js';
import { indexNewMessages } from '../../ai/ragService.js';
import { loadEmbeddingModel, getEmbeddingStatus, onEmbeddingStatusChange } from '../../ai/embeddingService.js';
import { autoTitleChat } from '../../ai/autoTitle.js';
import { getCachedResponse, setCachedResponse } from '../../ai/responseCache.js';
import { needsSummary, generateRollingSummary } from '../../ai/summaryService.js';

export default function ChatArea({ currentChatId, currentWorkspaceId, onOpenSettings }) {
  const [input, setInput] = useState('');
  const [sendHovered, setSendHovered] = useState(false);
  const [isStreaming, setIsStreaming] = useState(false);
  const [snapshotStatus, setSnapshotStatus] = useState(null); // null | 'loading' | 'success' | 'error'
  const [snapshotPreview, setSnapshotPreview] = useState(null); // preview result for diff modal
  const [errorMsg, setErrorMsg] = useState('');
  const messagesEndRef = useRef(null);
  const textareaRef = useRef(null);
  const abortRef = useRef(null);
  const streamingRef = useRef({ id: null, text: '' }); // In-memory streaming buffer

  const [embeddingStatus, setEmbeddingStatus] = useState(getEmbeddingStatus());
  const [streamingText, setStreamingText] = useState(''); // Local streaming state for UI

  const dbMessages = useLiveQuery(
    () => currentChatId ? getMessagesByChat(currentChatId) : [],
    [currentChatId],
    []
  );

  // Merge streaming buffer over DB messages for a smooth UI
  const messages = useMemo(() => {
    if (!streamingRef.current.id || !streamingText) return dbMessages;
    return dbMessages?.map(m =>
      m.id === streamingRef.current.id ? { ...m, content: streamingText } : m
    ) ?? [];
  }, [dbMessages, streamingText]);

  // Preload embedding model when a workspace is active
  useEffect(() => {
    if (!currentWorkspaceId) return;
    loadEmbeddingModel().catch(() => {});
    const unsub = onEmbeddingStatusChange(setEmbeddingStatus);
    return unsub;
  }, [currentWorkspaceId]);

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages]);

  // Auto-resize textarea
  useEffect(() => {
    const ta = textareaRef.current;
    if (!ta) return;
    ta.style.height = 'auto';
    ta.style.height = Math.min(ta.scrollHeight, 200) + 'px';
  }, [input]);

  const handleSend = useCallback(async () => {
    if (!input.trim() || !currentChatId || isStreaming) return;
    const userText = input.trim();
    setInput('');
    setErrorMsg('');

    // Add user message
    await addMessage(currentChatId, 'user', userText);

    // Create placeholder assistant message for streaming
    const assistantMsg = await addMessage(currentChatId, 'assistant', '...');
    setIsStreaming(true);

    // Check Response Cache first to save tokens
    const cached = await getCachedResponse(currentWorkspaceId, userText);
    if (cached) {
      setIsStreaming(true);
      // Typewriter effect for cached response to simulate thought
      const speed = 15;
      let text = '';
      for (let i = 0; i < cached.length; i++) {
        text += cached[i];
        if (i % 5 === 0) await updateMessageContent(assistantMsg.id, text);
        await new Promise(r => setTimeout(r, speed));
      }
      await updateMessageContent(assistantMsg.id, cached);
      setIsStreaming(false);
      return;
    }

    try {
      // Compile context (system prompt + memory items + recent history)
      const { messages: compiled, metadata: contextMeta } = await compileContext(currentChatId, currentWorkspaceId);
      if (contextMeta) {
        console.log(`📋 Context: ${contextMeta.pinnedCount} pinned, ${contextMeta.ragResultCount} RAG, ~${contextMeta.tokenEstimate} tokens`);
      }

      // Create abort controller for cancellation
      const controller = new AbortController();
      abortRef.current = controller;

      // Throttle DB writes during streaming to prevent IndexedDB flooding.
      // UI renders from local streamingText state (immediate), while DB writes
      // happen every 800ms (coarser) to avoid useLiveQuery re-render storms.
      let latestText = '';
      let writeTimer = null;
      streamingRef.current = { id: assistantMsg.id, text: '' };
      const DB_WRITE_INTERVAL = 800; // ms between IndexedDB flushes

      const flushToDb = () => {
        if (latestText) updateMessageContent(assistantMsg.id, latestText);
        writeTimer = null;
      };

      await streamChat(compiled, (accumulated) => {
        latestText = accumulated;
        streamingRef.current.text = accumulated;
        setStreamingText(accumulated); // Instant UI update via React state
        if (!writeTimer) {
          writeTimer = setTimeout(flushToDb, DB_WRITE_INTERVAL);
        }
      }, controller.signal);

      // Final write — ensure the complete response is persisted
      if (writeTimer) clearTimeout(writeTimer);
      streamingRef.current = { id: null, text: '' };
      setStreamingText('');
      if (latestText) {
        await updateMessageContent(assistantMsg.id, latestText);
        await setCachedResponse(currentWorkspaceId, userText, latestText); // Cache it!
      }

      // Auto-title chat after first exchange (2 messages = user + assistant)
      const currentMessages = await getMessagesByChat(currentChatId);
      if (currentMessages.length <= 2) {
        autoTitleChat(currentChatId, userText, latestText).catch(() => {});
      }

    } catch (err) {
      if (err.name === 'AbortError') {
        // User cancelled — keep whatever was streamed
      } else if (err.message === 'NO_API_KEY') {
        await updateMessageContent(assistantMsg.id,
          '⚠️ **No API key configured.** Click the ⚙ Settings button in the top bar to add your OpenAI or Anthropic key.');
        setErrorMsg('Configure your API key in Settings to chat with AI.');
      } else {
        await updateMessageContent(assistantMsg.id,
          `❌ **Error:** ${err.message}\n\nCheck your API key and network connection.`);
        setErrorMsg(err.message);
      }
    } finally {
      setIsStreaming(false);
      abortRef.current = null;

      // Background: index new messages for RAG (non-blocking)
      if (currentWorkspaceId) {
        const doIndex = () => indexNewMessages(currentWorkspaceId).catch(() => {});
        if (typeof requestIdleCallback !== 'undefined') {
          requestIdleCallback(doIndex);
        } else {
          setTimeout(doIndex, 500);
        }
      }

      // Background: check if rolling summary needs updating
      if (currentChatId) {
        const doSummary = async () => {
          try {
            if (await needsSummary(currentChatId)) {
              await generateRollingSummary(currentChatId);
            }
          } catch (err) {
            console.warn('Rolling summary skipped:', err.message);
          }
        };
        // Delay summary generation to avoid competing with RAG indexing
        setTimeout(doSummary, 2000);
      }
    }
  }, [input, currentChatId, currentWorkspaceId, isStreaming]);

  const handleStop = () => {
    abortRef.current?.abort();
  };

  // Phase 1: Preview snapshot and show diff modal
  const handleSnapshot = useCallback(async () => {
    if (!currentWorkspaceId || !currentChatId || snapshotStatus === 'loading') return;
    setSnapshotStatus('loading');

    const result = await previewSnapshot(currentWorkspaceId, currentChatId);

    if (result.success) {
      setSnapshotStatus(null);
      setSnapshotPreview(result);
    } else {
      setSnapshotStatus('error');
      if (result.error === 'NO_API_KEY') {
        setErrorMsg('Configure your API key in Settings to use snapshots.');
      } else {
        setErrorMsg(`Snapshot failed: ${result.error}`);
      }
      setTimeout(() => setSnapshotStatus(null), 4000);
    }
  }, [currentWorkspaceId, currentChatId, snapshotStatus]);

  // Phase 2: Commit accepted items from diff review
  const handleDiffCommit = useCallback(async (acceptedItems) => {
    if (!currentWorkspaceId || !currentChatId || !snapshotPreview) return;
    setSnapshotPreview(null);
    setSnapshotStatus('loading');

    const result = await commitPreviewedItems(
      currentWorkspaceId, currentChatId,
      acceptedItems, snapshotPreview.messageCount, snapshotPreview.stateFile
    );

    if (result.success) {
      setSnapshotStatus('success');

      let msg = '📸 **Snapshot committed!**\n\n';

      if (result.newItems?.length > 0) {
        const byCategory = {};
        for (const item of result.newItems) {
          if (!byCategory[item.category]) byCategory[item.category] = [];
          byCategory[item.category].push(item.content);
        }

        const categoryLabels = {
          decision: '🔒 Decisions',
          fact: '📌 Facts',
          preference: '⚙️ Preferences',
          rejected: '🚫 Rejected',
          code_style: '🎨 Code Style',
        };

        for (const [cat, items] of Object.entries(byCategory)) {
          const label = categoryLabels[cat] || cat;
          msg += `**${label}:**\n`;
          items.forEach(i => { msg += `- ${i}\n`; });
          msg += '\n';
        }

        if (result.skipped > 0) {
          msg += `_${result.skipped} duplicate item${result.skipped !== 1 ? 's' : ''} skipped._\n`;
        }

        msg += '\nItems are now in your Memory Panel. You can pin, edit, or tag them there.';
      } else {
        msg = '📸 **Snapshot committed!** No new information was detected.';
      }

      await addMessage(currentChatId, 'assistant', msg);
      setTimeout(() => setSnapshotStatus(null), 3000);
    } else {
      setSnapshotStatus('error');
      setErrorMsg(`Snapshot commit failed: ${result.error}`);
      setTimeout(() => setSnapshotStatus(null), 4000);
    }
  }, [currentWorkspaceId, currentChatId, snapshotPreview]);

  const handleDiffCancel = useCallback(() => {
    setSnapshotPreview(null);
  }, []);

  const handleKeyDown = (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); handleSend(); }
  };

  if (!currentChatId) {
    return (
      <div style={{ height: '100%', display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', backgroundColor: '#0d1117' }}>
        <div style={{ textAlign: 'center', maxWidth: '360px', padding: '0 24px' }}>
          <div style={{ width: '56px', height: '56px', borderRadius: '16px', background: 'linear-gradient(135deg, #0d2137, #1a1038)', border: '1px solid #21262d', display: 'flex', alignItems: 'center', justifyContent: 'center', margin: '0 auto 20px' }}>
            <Database size={26} color="#58a6ff" />
          </div>
          <h2 style={{ margin: '0 0 10px', fontSize: '18px', fontWeight: '600', color: '#e6edf3' }}>Create or select a chat</h2>
          <p style={{ margin: 0, fontSize: '13.5px', color: '#6e7681', lineHeight: 1.75 }}>
            Conversations live inside workspaces. Everything you discuss feeds the workspace memory loop.
          </p>
        </div>
      </div>
    );
  }

  return (
    <div style={{ height: '100%', display: 'flex', flexDirection: 'column', backgroundColor: '#0d1117' }}>
      {/* Header */}
      <div style={{ height: '44px', borderBottom: '1px solid #21262d', display: 'flex', alignItems: 'center', justifyContent: 'space-between', padding: '0 20px', flexShrink: 0, backgroundColor: '#0d1117' }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
          <span style={{ fontSize: '13px', color: '#6e7681' }}>Conversation</span>
          {isStreaming && (
            <div style={{ display: 'flex', alignItems: 'center', gap: '5px' }}>
              <Loader2 size={12} color="#58a6ff" style={{ animation: 'spin 1s linear infinite' }} />
              <span style={{ fontSize: '11px', color: '#58a6ff' }}>streaming…</span>
            </div>
          )}
          {embeddingStatus !== 'idle' && (
            <div style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>
              <div style={{
                width: '6px', height: '6px', borderRadius: '50%',
                backgroundColor: embeddingStatus === 'ready' ? '#4ade80' : embeddingStatus === 'loading' ? '#f59e0b' : '#ef4444',
                animation: embeddingStatus === 'loading' ? 'pulse 1.5s infinite' : 'none',
              }} />
              <span style={{ fontSize: '10px', color: '#484f58' }}>
                {embeddingStatus === 'ready' ? 'Memory active' : embeddingStatus === 'loading' ? 'Loading memory…' : 'Memory unavailable'}
              </span>
            </div>
          )}
        </div>
        <SnapshotButton onClick={handleSnapshot} status={snapshotStatus} />
      </div>

      {/* Messages */}
      <div style={{ flex: 1, overflowY: 'auto', padding: '24px 0' }}>
        {messages?.length === 0 ? (
          <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', height: '100%', textAlign: 'center', padding: '0 24px' }}>
            <Zap size={28} color="#21262d" style={{ marginBottom: '16px' }} />
            <h3 style={{ margin: '0 0 8px', fontSize: '16px', fontWeight: '600', color: '#e6edf3' }}>Snapshot AI Ready</h3>
            <p style={{ margin: 0, color: '#6e7681', fontSize: '13.5px', lineHeight: 1.7, maxWidth: '320px' }}>
              Start your conversation. Hit <strong style={{ color: '#a78bfa' }}>Commit Snapshot</strong> to lock in important decisions to the project memory.
            </p>
          </div>
        ) : (
          <div style={{ maxWidth: '760px', margin: '0 auto', padding: '0 20px', display: 'flex', flexDirection: 'column', gap: '20px' }}>
            {messages?.map(msg => (
              <MessageBubble
                key={msg.id}
                message={msg}
                workspaceId={currentWorkspaceId}
                chatId={currentChatId}
              />
            ))}
            <div ref={messagesEndRef} />
          </div>
        )}
      </div>

      {/* Input */}
      <div style={{ padding: '12px 20px 20px', flexShrink: 0 }}>
        <div style={{ maxWidth: '760px', margin: '0 auto' }}>
          {/* Error banner */}
          {errorMsg && (
            <div style={{
              display: 'flex', alignItems: 'center', gap: '8px',
              padding: '8px 12px', marginBottom: '10px', borderRadius: '8px',
              backgroundColor: '#1c1208', border: '1px solid #f59e0b30',
              fontSize: '12px', color: '#f59e0b',
            }}>
              <AlertTriangle size={13} style={{ flexShrink: 0 }} />
              <span style={{ flex: 1 }}>{errorMsg}</span>
              {errorMsg.includes('API key') && onOpenSettings && (
                <button onClick={onOpenSettings} style={{
                  background: 'none', border: '1px solid #f59e0b40', color: '#f59e0b',
                  padding: '3px 10px', borderRadius: '6px', fontSize: '11px',
                  cursor: 'pointer', fontWeight: '600', whiteSpace: 'nowrap',
                }}>
                  Open Settings
                </button>
              )}
            </div>
          )}

          <div style={{ position: 'relative', backgroundColor: '#161b22', border: '1px solid #30363d', borderRadius: '12px', transition: 'border-color 0.15s' }}>
            <textarea
              ref={textareaRef}
              value={input}
              onChange={e => setInput(e.target.value)}
              onKeyDown={handleKeyDown}
              placeholder={isStreaming ? "AI is responding…" : "Message the AI… (Enter to send, Shift+Enter for newline)"}
              disabled={isStreaming}
              style={{
                width: '100%', background: 'none', border: 'none', outline: 'none',
                padding: '14px 52px 14px 16px', fontSize: '14px', color: '#e6edf3',
                resize: 'none', lineHeight: 1.65, boxSizing: 'border-box',
                minHeight: '52px', maxHeight: '200px', overflowY: 'auto',
                fontFamily: 'inherit',
                opacity: isStreaming ? 0.5 : 1,
              }}
            />
            {isStreaming ? (
              <StopButton onClick={handleStop} />
            ) : (
              <button
                onClick={handleSend}
                disabled={!input.trim()}
                onMouseEnter={() => setSendHovered(true)}
                onMouseLeave={() => setSendHovered(false)}
                style={{
                  position: 'absolute', right: '10px', bottom: '10px',
                  width: '32px', height: '32px', borderRadius: '8px', border: 'none',
                  display: 'flex', alignItems: 'center', justifyContent: 'center', cursor: 'pointer',
                  backgroundColor: input.trim() ? (sendHovered ? '#1d4ed8' : '#2563eb') : '#21262d',
                  color: input.trim() ? '#fff' : '#484f58',
                  transition: 'background-color 0.15s',
                }}
              >
                <SendHorizonal size={15} />
              </button>
            )}
          </div>
          <div style={{ marginTop: '8px', textAlign: 'center', fontSize: '11px', color: '#484f58' }}>
            AI responses are generated with your API key. Verify critical decisions.
          </div>
        </div>
      </div>

      {/* Snapshot diff review modal */}
      {snapshotPreview && (
        <SnapshotDiffModal
          preview={snapshotPreview}
          onCommit={handleDiffCommit}
          onCancel={handleDiffCancel}
        />
      )}
    </div>
  );
}

function SnapshotButton({ onClick, status }) {
  const [h, setH] = useState(false);

  const isLoading = status === 'loading';
  const isSuccess = status === 'success';
  const isError = status === 'error';

  let bgColor = h ? '#2d1f4e' : '#1e1438';
  let textColor = h ? '#c4b5fd' : '#a78bfa';
  let label = 'Commit Snapshot';
  let icon = <Database size={13} />;

  if (isLoading) {
    bgColor = '#1e1438'; textColor = '#a78bfa';
    label = 'Analyzing…';
    icon = <Loader2 size={13} style={{ animation: 'spin 1s linear infinite' }} />;
  } else if (isSuccess) {
    bgColor = '#0a3622'; textColor = '#4ade80';
    label = 'Committed!';
    icon = <CheckCircle2 size={13} />;
  } else if (isError) {
    bgColor = '#3b1218'; textColor = '#f87171';
    label = 'Failed';
    icon = <AlertTriangle size={13} />;
  }

  return (
    <button
      onClick={onClick}
      disabled={isLoading}
      onMouseEnter={() => setH(true)}
      onMouseLeave={() => setH(false)}
      style={{
        display: 'flex', alignItems: 'center', gap: '6px',
        fontSize: '12px', fontWeight: '600',
        cursor: isLoading ? 'wait' : 'pointer',
        color: textColor, backgroundColor: bgColor,
        border: '1px solid #4c1d9520',
        padding: '5px 12px', borderRadius: '20px',
        transition: 'all 0.15s',
      }}
    >
      {icon}
      {label}
    </button>
  );
}

function StopButton({ onClick }) {
  const [h, setH] = useState(false);
  return (
    <button
      onClick={onClick}
      onMouseEnter={() => setH(true)}
      onMouseLeave={() => setH(false)}
      style={{
        position: 'absolute', right: '10px', bottom: '10px',
        height: '32px', borderRadius: '8px', border: 'none',
        display: 'flex', alignItems: 'center', justifyContent: 'center',
        gap: '5px', cursor: 'pointer', padding: '0 12px',
        backgroundColor: h ? '#3b1218' : '#21262d',
        color: h ? '#f87171' : '#8b949e',
        fontSize: '12px', fontWeight: '500',
        transition: 'all 0.15s',
      }}
    >
      <div style={{ width: '8px', height: '8px', borderRadius: '2px', backgroundColor: 'currentColor' }} />
      Stop
    </button>
  );
}

function MessageBubble({ message, workspaceId, chatId }) {
  const isUser = message.role === 'user';
  const [hovered, setHovered] = useState(false);
  const [teachMode, setTeachMode] = useState(false);
  const [teachCategory, setTeachCategory] = useState('fact');
  const [teachContent, setTeachContent] = useState('');
  const [teachSaved, setTeachSaved] = useState(false);

  const handleRemember = () => {
    // Pre-fill with first 200 chars of the message content
    const preview = message.content?.slice(0, 200) || '';
    setTeachContent(preview);
    setTeachMode(true);
    setTeachSaved(false);
  };

  const handleTeachSave = async () => {
    if (!teachContent.trim() || !workspaceId) return;
    const tags = suggestTags(teachContent, '');
    await addMemoryItem({
      workspaceId,
      chatId,
      messageId: message.id,
      content: teachContent.trim(),
      category: teachCategory,
      tags,
      source: 'teach-mode',
      scope: 'workspace',
    });
    setTeachSaved(true);
    setTimeout(() => { setTeachMode(false); setTeachSaved(false); }, 1200);
  };

  const TEACH_CATS = [
    { key: 'decision', label: 'Decision', color: '#f59e0b' },
    { key: 'fact', label: 'Fact', color: '#3b82f6' },
    { key: 'preference', label: 'Preference', color: '#10b981' },
    { key: 'code_style', label: 'Code Style', color: '#a78bfa' },
  ];

  return (
    <div
      style={{ display: 'flex', gap: '12px', alignItems: 'flex-start', flexDirection: isUser ? 'row-reverse' : 'row' }}
      onMouseEnter={() => setHovered(true)} onMouseLeave={() => setHovered(false)}
    >
      <div style={{
        width: '32px', height: '32px', borderRadius: '50%', flexShrink: 0,
        display: 'flex', alignItems: 'center', justifyContent: 'center',
        fontSize: '12px', fontWeight: '700',
        backgroundColor: isUser ? '#21262d' : '#1a1038',
        border: `1px solid ${isUser ? '#30363d' : '#4c1d95'}`,
        color: isUser ? '#8b949e' : '#a78bfa',
      }}>
        {isUser ? 'U' : <Database size={14} />}
      </div>
      <div style={{
        maxWidth: '80%', borderRadius: '12px',
        backgroundColor: isUser ? '#161b22' : '#0d1117',
        border: '1px solid #21262d',
        borderTopRightRadius: isUser ? '4px' : '12px',
        borderTopLeftRadius: isUser ? '12px' : '4px',
        overflow: 'hidden',
      }}>
        <div style={{ padding: '12px 16px', fontSize: '14px', lineHeight: 1.7, color: '#e6edf3' }}>
          {isUser ? (
            <span style={{ whiteSpace: 'pre-wrap' }}>{message.content}</span>
          ) : (
            <ReactMarkdown
              remarkPlugins={[remarkGfm]}
              components={{
                p: ({children}) => <p style={{ margin: '0 0 10px', lineHeight: 1.75 }}>{children}</p>,
                code: ({inline, children}) => inline
                  ? <code style={{ backgroundColor: '#161b22', padding: '2px 6px', borderRadius: '4px', fontSize: '12.5px', color: '#79c0ff', fontFamily: 'monospace' }}>{children}</code>
                  : <pre style={{ backgroundColor: '#161b22', border: '1px solid #30363d', borderRadius: '8px', padding: '14px', overflow: 'auto', margin: '10px 0' }}><code style={{ fontSize: '13px', color: '#e6edf3', fontFamily: 'monospace' }}>{children}</code></pre>,
                ul: ({children}) => <ul style={{ margin: '6px 0', paddingLeft: '20px' }}>{children}</ul>,
                li: ({children}) => <li style={{ marginBottom: '4px' }}>{children}</li>,
                strong: ({children}) => <strong style={{ color: '#e6edf3', fontWeight: '600' }}>{children}</strong>,
              }}
            >
              {message.content}
            </ReactMarkdown>
          )}
        </div>

        {/* Teach mode: "Remember this" action bar */}
        {!isUser && hovered && !teachMode && workspaceId && (
          <div style={{ padding: '0 12px 8px', display: 'flex', justifyContent: 'flex-end' }}>
            <button
              onClick={handleRemember}
              style={{
                display: 'flex', alignItems: 'center', gap: '4px',
                fontSize: '11px', color: '#7c3aed', background: 'none',
                border: '1px solid #7c3aed44', borderRadius: '5px',
                padding: '2px 8px', cursor: 'pointer', fontWeight: '500',
                transition: 'all 0.15s',
              }}
            >
              <Bookmark size={10} /> Remember this
            </button>
          </div>
        )}

        {/* Teach mode: inline edit form */}
        {teachMode && (
          <div style={{
            padding: '8px 12px 10px', borderTop: '1px solid #21262d',
            backgroundColor: '#161b22',
          }}>
            {teachSaved ? (
              <div style={{ display: 'flex', alignItems: 'center', gap: '6px', color: '#4ade80', fontSize: '12px', fontWeight: '500' }}>
                <CheckCircle2 size={13} /> Saved to memory
              </div>
            ) : (
              <>
                <textarea
                  value={teachContent}
                  onChange={e => setTeachContent(e.target.value)}
                  placeholder="What should I remember?"
                  autoFocus
                  rows={2}
                  style={{
                    width: '100%', boxSizing: 'border-box',
                    background: '#0d1117', border: '1px solid #30363d',
                    borderRadius: '6px', padding: '6px 8px',
                    color: '#e6edf3', fontSize: '12px', lineHeight: 1.5,
                    resize: 'vertical', minHeight: '36px', outline: 'none',
                    fontFamily: 'inherit',
                  }}
                />
                <div style={{ display: 'flex', alignItems: 'center', gap: '4px', marginTop: '6px', flexWrap: 'wrap' }}>
                  {TEACH_CATS.map(c => (
                    <button
                      key={c.key}
                      onClick={() => setTeachCategory(c.key)}
                      style={{
                        fontSize: '10px', padding: '1px 7px', borderRadius: '4px',
                        border: `1px solid ${teachCategory === c.key ? c.color : '#21262d'}`,
                        backgroundColor: teachCategory === c.key ? `${c.color}1a` : 'transparent',
                        color: teachCategory === c.key ? c.color : '#484f58',
                        cursor: 'pointer', fontWeight: teachCategory === c.key ? '600' : '400',
                      }}
                    >
                      {c.label}
                    </button>
                  ))}
                  <div style={{ flex: 1 }} />
                  <button
                    onClick={() => setTeachMode(false)}
                    style={{
                      fontSize: '11px', color: '#8b949e', background: 'none',
                      border: '1px solid #30363d', borderRadius: '5px',
                      padding: '2px 8px', cursor: 'pointer',
                    }}
                  >
                    Cancel
                  </button>
                  <button
                    onClick={handleTeachSave}
                    style={{
                      fontSize: '11px', color: '#4ade80', background: '#4ade8015',
                      border: '1px solid #4ade8044', borderRadius: '5px',
                      padding: '2px 8px', cursor: 'pointer', fontWeight: '500',
                    }}
                  >
                    Save
                  </button>
                </div>
              </>
            )}
          </div>
        )}
      </div>
    </div>
  );
}
